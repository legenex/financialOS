{
  "name": "@financialos/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx src/migrate-cli.ts",
    "db:bootstrap": "tsx src/bootstrap-cli.ts",
    "db:seed-demo": "tsx src/seed/demo-cli.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9",
    "pg-boss": "12.33.0",
    "zod": "4.6.5",
    "@financialos/contracts": "0.1.0",
    "@financialos/domain": "0.1.0",
    "@financialos/security": "0.1.0"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10"
  }
}
